        "proof"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "ref": {
          "$ref": "#/$defs/revision-ref"
        },
        "relation": {
          "enum": [
            "source",
            "lineage"
          ]
        },
        "match_id": {
          "type": "string",
          "format": "memy-identifier"
        },
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "count",
            "siblings"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "siblings": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "purge-active": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "operation_id"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "operation_id": {
          "type": "string",
          "format": "memy-identifier"
        }
      }
    },
    "purge-job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "operation_id",
        "phase",
        "resume",
        "after",
        "queued",
        "next",
        "clean",
        "part",
        "origin"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "operation_id": {
          "type": "string",
          "format": "memy-identifier"
        },
        "phase": {
          "enum": [
            "seed",
            "expand",
            "records",
            "proposals",
            "origins",
            "ack",
            "done",
            "emit"
          ]
        },
        "resume": {
          "enum": [
            "",
            "emit",
            "done"
          ]
        },
        "after": {
          "type": "string"
        },
        "queued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "next": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775808
        },
        "clean": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775808
        },
        "part": {
          "enum": [
            "history",
            "members",
            "finish"
          ]
        },
        "origin": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "ack"
              }
            }
          },
          "then": {
            "properties": {
              "resume": {
                "enum": [
                  "emit",
                  "done"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "resume": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "not": {
                  "const": "origins"
                }
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "purge-item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
