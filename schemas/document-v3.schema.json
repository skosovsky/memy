        "data": {
          "$ref": "#/$defs/revocation"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "purge"
        },
        "data": {
          "$ref": "#/$defs/purge"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "membership"
        },
        "data": {
          "$ref": "#/$defs/membership"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "purge-active"
        },
        "data": {
          "$ref": "#/$defs/purge-active"
        }
