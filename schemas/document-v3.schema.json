          },
          "then": {
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "format": "memy-identifier"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "scope"
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "epoch",
