          "$ref": "#/$defs/revision-ref"
        }
      }
    },
    "record": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "scope",
            "proposal",
            "state",
            "initial_state",
            "recorded_at",
            "authority_policy_version",
            "reconciliation",
            "lineage",
            "transitions"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "format": "memy-identifier"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "scope": {
              "$ref": "#/$defs/scope"
            },
            "proposal": {
              "allOf": [
                {
                  "$ref": "#/$defs/proposal"
                },
                {
                  "properties": {
                    "state": {
                      "const": "accepted"
                    }
                  }
                }
              ]
            },
            "state": {
              "enum": [
                "active",
                "superseded",
                "conflicted"
              ]
            },
            "initial_state": {
              "enum": [
                "active",
                "conflicted"
              ]
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time"
            },
            "lineage": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/revision-ref"
              }
            },
            "transitions": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/transition"
              }
            },
            "authority_policy_version": {
