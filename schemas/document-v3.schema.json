        "payload": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "contentEncoding": "base64"
        },
        "payload_codec": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "reference_codec": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid": {
          "$ref": "#/$defs/interval"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "lineage": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/revision-ref"
          }
        },
        "losses": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "uncertainties": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "retention": {
          "$ref": "#/$defs/retention"
        }
      }
    },
    "zero-proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
