      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "state": {
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "expired"
          ]
