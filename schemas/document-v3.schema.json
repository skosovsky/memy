      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "reference": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "contentEncoding": "base64"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest",
        "scope",
        "state",
        "payload",
        "payload_codec",
        "reference_codec",
        "sources",
        "evidence",
        "extractor",
        "observed_at",
        "valid",
        "expires_at",
        "lineage",
        "losses",
        "uncertainties",
        "created_at",
        "epoch",
        "retention"
