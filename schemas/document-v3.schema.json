        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "reason_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "purge-batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "scope",
        "epoch",
        "selector",
        "records",
        "chunk"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "records": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "format": "memy-identifier"
          },
          "maxItems": 1024
        },
        "chunk": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "sink-result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "acknowledged",
