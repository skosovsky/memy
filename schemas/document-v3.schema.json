  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "namespace",
        "subject"
      ],
      "properties": {
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\u0000]*$",
          "allOf": [
            {
              "pattern": "\\S"
            }
          ],
          "format": "memy-identifier"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\u0000]*$",
          "allOf": [
            {
              "pattern": "\\S"
            }
          ],
          "format": "memy-identifier"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\u0000]*$",
          "allOf": [
            {
              "pattern": "\\S"
            }
          ],
          "format": "memy-identifier"
        }
      }
    },
    "revision-ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "revision"
