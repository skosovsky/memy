        "state": {
          "enum": [
            "revocation_committed",
            "purge_pending",
            "complete",
            "failed"
          ]
        },
        "sinks": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/sink-result"
          }
        },
        "revoked_at": {
          "type": "string",
          "format": "date-time"
        },
        "canonical_complete": {
          "type": "boolean"
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "related",
        "policy_version",
        "basis"
      ],
      "properties": {
        "mode": {
          "enum": [
            "append",
            "duplicate",
            "supersede",
            "conflict"
          ]
        },
        "related": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/revision-ref"
          }
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ref",
        "relation",
