        "after": {
          "type": "string"
        },
        "resume_after": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "purge_operation": {
          "type": "string"
        }
      }
    },
    "purge-evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "operation_id",
        "ref",
        "root"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "operation_id": {
          "type": "string",
          "format": "memy-identifier"
        },
        "ref": {
          "$ref": "#/$defs/revision-ref"
        },
        "root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
