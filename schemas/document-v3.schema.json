              "minLength": 1,
              "format": "memy-identifier"
            },
            "reconciliation": {
              "$ref": "#/$defs/reconciliation"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "scope",
            "proposal",
            "state",
            "initial_state",
            "recorded_at",
            "authority_policy_version",
            "reconciliation",
            "lineage",
            "transitions"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "format": "memy-identifier"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "scope": {
              "$ref": "#/$defs/scope"
            },
            "proposal": {
              "$ref": "#/$defs/zero-proposal"
            },
            "state": {
              "const": "revoked"
            },
            "initial_state": {
              "const": "revoked"
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time"
            },
            "lineage": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 0
            },
            "transitions": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 0
            },
            "authority_policy_version": {
              "const": ""
            },
            "reconciliation": {
              "type": "null"
            }
          }
        }
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "proposal_revision",
        "digest",
        "actor",
        "scope",
        "policy_version",
        "expires_at"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "proposal_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "record_id",
        "revision"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "commit-receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "record_id",
        "revision",
        "canonical_committed",
        "visibility"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "format": "memy-identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "canonical_committed": {
          "const": true
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "digest",
            "proposals",
            "receipt",
            "epoch"
          ],
          "properties": {
            "action": {
              "enum": [
                "remember",
                "extract",
                "revise"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "proposals": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/proposal-ref"
              },
              "minItems": 1
            },
            "receipt": {
              "type": "null"
            },
            "epoch": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "digest",
            "proposals",
            "receipt",
            "epoch"
          ],
          "properties": {
            "action": {
              "enum": [
                "commit"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "proposals": {
              "type": "null"
            },
            "receipt": {
              "$ref": "#/$defs/commit-receipt"
            },
            "epoch": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "digest",
            "proposals",
            "receipt",
            "epoch"
          ],
          "properties": {
            "action": {
              "enum": [
                "forget"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "proposals": {
              "type": "null"
            },
            "receipt": {
              "type": "null"
            },
            "epoch": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "digest",
            "proposals",
            "receipt",
            "epoch"
          ],
          "properties": {
            "action": {
              "enum": [
                "reintroduce"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "proposals": {
              "type": "null"
            },
            "receipt": {
              "type": "null"
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          }
        }
      ]
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "recorded_at"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "record",
            "source",
            "subject",
            "scope"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "record",
                  "source",
                  "subject"
                ]
              }
