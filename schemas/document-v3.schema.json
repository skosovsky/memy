              "const": "0001-01-01T00:00:00Z"
            },
            "to": {
              "const": "0001-01-01T00:00:00Z"
            }
          }
        },
        "expires_at": {
          "const": "0001-01-01T00:00:00Z"
        },
        "lineage": {
          "const": null
        },
        "losses": {
          "const": null
        },
        "uncertainties": {
          "const": null
        },
        "created_at": {
          "const": "0001-01-01T00:00:00Z"
        },
        "epoch": {
          "const": 0
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_version",
            "expires_at"
          ],
          "properties": {
            "policy_version": {
              "const": ""
            },
            "expires_at": {
              "const": "0001-01-01T00:00:00Z"
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "state",
